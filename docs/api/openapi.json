  "components": {
    "headers": {
      "RequestId": {
        "description": "Server-generated correlation UUID. Caller IDs are not trusted.",
        "schema": {
          "$ref": "#/components/schemas/RequestId"
        }
      },
      "NoSniff": {
        "description": "Disable MIME sniffing.",
        "schema": {
          "type": "string",
          "const": "nosniff"
        }
      },
      "NoStore": {
        "description": "Do not cache the response.",
        "schema": {
          "type": "string",
          "const": "no-store"
        }
      },
      "RetrySeconds": {
        "description": "Positive integer delay in seconds until this peer's window or the earliest live-peer bucket expires.",
        "schema": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "example": "60"
      },
      "RetryOne": {
        "description": "Retry delay in seconds; fixed at 1 for generic 503.",
        "schema": {
          "type": "string",
          "const": "1"
        }
      }
    },
    "schemas": {
      "RequestId": {
        "type": "string",
        "format": "uuid",
        "example": "3e9dc602-763b-4cb1-8ea2-77c7d66cd439"
      },
      "ProbeOk": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "ProbeUnavailable": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "unavailable"
          }
        }
      },
      "RegistrationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "description": "Raw ASCII input <=1024 UTF-8 bytes. Trim only outer SP/HTAB and lowercase entire address. Canonical address <=254 bytes; dot-atom local part <=64 bytes; domain has >=2 labels of 1-63 alphanumeric/hyphen characters with alphanumeric ends. Reject controls, internal whitespace, Unicode, quoted local parts, domain literals and trailing domain dot. Dots/+ suffixes preserved; no DNS/provider rewrite. Deliberately no raw JSON Schema email format: outer space/tab is accepted and normalization precedes syntax validation."
          },
          "password": {
            "type": "string",
            "writeOnly": true,
            "description": "Well-formed Unicode, <=1024 raw UTF-8 bytes; NFC normalization then 15-128 Unicode code points. No trimming, truncation or composition rules; spaces and case are significant. Whole NFC/lowercase matches against the pinned local common-password corpus, submitted canonical email/local part, commerceapp12345, commerce_app12345 and commerce-app12345 are rejected. Screening folds case, hashing preserves it. Raw minLength/maxLength are deliberately omitted: pre-normalization schema lengths would misrepresent the normalized server policy."
          }
        }
      },
      "RegistrationAccepted": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "message"
        ],
        "properties": {
          "status": {
            "const": "accepted"
          },
          "message": {
            "const": "Registration request processed."
          }
        }
      },
      "RegistrationValidationError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "message",
          "field",
          "code",
          "requestId"
        ],
        "properties": {
          "error": {
            "const": "invalid_registration"
          },
          "message": {
            "const": "Invalid registration request"
          },
          "field": {
            "type": "string",
            "enum": [
              "body",
              "email",
              "password"
            ]
          },
          "code": {
            "type": "string",
            "enum": [
              "required",
              "invalid_type",
              "invalid_body",
              "unexpected_field",
              "invalid_email",
              "password_encoding",
              "password_too_large",
              "password_length",
              "password_blocklisted"
            ]
          },
          "requestId": {
