{
  "openapi": "3.1.2",
  "info": {
    "title": "Commerce_App HTTP API",
    "version": "0.1.0",
    "description": "Current local NestJS services: health probes, registration and account sessions. Verification, recovery and account browser flow are not implemented. Responses reaching application middleware include server-generated X-Request-Id and nosniff; probes, registration and application errors are no-store. JSON bodies default to a 1 MiB limit; compressed bodies are unsupported. Lower-level header/receive failures may terminate the connection or return non-JSON 408/431 without application headers. See the repository docs/api/README.md for setup, CORS/preflight, examples and detailed semantics. This document describes current behavior, not public deployment readiness."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3001",
      "description": "Local API default; substitute the configured API_PORT in your client."
    }
  ],
  "security": [],
  "tags": [
    {
      "name": "Health",
      "description": "Liveness and bounded database readiness."
    },
    {
      "name": "Accounts",
      "description": "Ordinary account registration and sessions."
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "getLiveness",
        "summary": "Check HTTP process liveness",
        "description": "Independent of PostgreSQL and registration admission. No request body is needed. Remains live while the process can serve requests.",
        "responses": {
          "200": {
            "description": "HTTP process is live; database availability is irrelevant.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/NoSniff"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeOk"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadJson"
          },
          "413": {
            "$ref": "#/components/responses/TooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMedia"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "getReadiness",
        "summary": "Check dependency readiness",
        "description": "Fresh database probe with at most a two-second deadline including pool acquisition. Overlapping requests coalesce one active probe; completed results are not cached for later requests. Shutdown makes readiness unavailable. This does not establish account schema availability. Unexpected thrown failures use the generic 500 envelope.",
        "responses": {
          "200": {
            "description": "Database probe succeeded and shutdown has not begun. This does not check account schema or migration state.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/NoSniff"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeOk"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadJson"
          },
          "413": {
            "$ref": "#/components/responses/TooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMedia"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "description": "Database probe failed/timed out or shutdown began. This status-only body does not carry Retry-After.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/NoSniff"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeUnavailable"
                },
                "example": {
                  "status": "unavailable"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/register": {
      "post": {
        "tags": [
          "Accounts"
        ],
        "operationId": "registerAccount",
        "summary": "Process email/password registration",
        "description": "Exactly email/password strings; unknown properties fail before email/password validation. Creates an unverified ordinary account and credential atomically if canonical email is absent; duplicates never replace credentials or timestamps. New and existing valid addresses both hash and return the same exact 202, without account IDs, existence flags, Location, cookie, token or email-delivery claim. SQL/network timing is not guaranteed constant. Five parsed attempts per direct socket peer per 60-second fixed window per process, at most 1024 live peer buckets; forwarded identity ignored. Field-invalid attempts consume peer budget; parser failures do not. Admission can return 429 before validation. After validation, at most two hash/persistence operations run, with no queue; saturation returns 503. A disconnect does not cancel admitted work. Restart resets peer limits; replicas multiply them.",
        "requestBody": {
          "required": true,
          "description": "An uncompressed application/json object containing only email and password. Header charset parameters are supported.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrationRequest"
              },
              "example": {
                "email": "reader+docs@example.com",
                "password": "Synthetic docs passphrase 628!"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Request processing succeeded for a new or existing canonical email. This does not confirm creation, verification, email delivery or sign-in.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/NoSniff"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationAccepted"
                },
                "example": {
                  "status": "accepted",
                  "message": "Registration request processed."
                }
              }
            }
          },
          "400": {
            "description": "Input shape/email/password policy failure, or an earlier JSON parser failure. Field/code exist only on validation errors.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/NoSniff"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/RegistrationValidationError"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "error",
                        "message",
                        "requestId"
                      ],
                      "properties": {
                        "error": {
                          "const": "http_400"
                        },
                        "message": {
                          "const": "Request rejected"
                        },
                        "requestId": {
                          "$ref": "#/components/schemas/RequestId"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "413": {
            "$ref": "#/components/responses/TooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMedia"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/accounts/sessions": {
      "post": {
        "tags": [
          "Accounts"
        ],
        "operationId": "createAccountSession",
        "summary": "Sign in",
        "description": "Allows unverified accounts in this local milestone. Unknown and incorrect credentials return the same 401. Five parsed attempts per direct peer per 60 seconds, 1024 peer buckets; shares two password-work slots with registration. Send the required header and an allowed Origin when present.",
        "parameters": [
          {
            "name": "X-Commerce-Request",
            "in": "header",
            "required": true,
            "description": "Must equal 1; required on every session endpoint.",
            "schema": {
              "type": "string",
              "const": "1"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "description": "Same canonical email identity as registration."
                  },
                  "password": {
                    "type": "string",
                    "writeOnly": true,
                    "description": "Well-formed Unicode, at most 1024 UTF-8 bytes, normalized to NFC. Existing credentials are verified without reapplying registration password policy."
                  }
                }
              },
              "example": {
                "email": "reader@example.com",
                "password": "Synthetic docs passphrase 628!"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session created.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/NoSniff"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              },
              "Set-Cookie": {
                "description": "Host-only session cookie with Secure, HttpOnly, SameSite=Strict and Path=/.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "const": "signed_in"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Malformed input or JSON.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/NoSniff"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "error",
                    "message",
                    "requestId"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "requestId": {
                      "$ref": "#/components/schemas/RequestId"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/NoSniff"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "error",
                    "message",
                    "requestId"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "requestId": {
                      "$ref": "#/components/schemas/RequestId"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Untrusted origin or missing request header.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "X-Content-Type-Options": {
                "$ref": "#/components/headers/NoSniff"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "error",
                    "message",
                    "requestId"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "requestId": {
                      "$ref": "#/components/schemas/RequestId"
                    }
                  }
                }
              }
            }
          },
          "413": {
            "$ref": "#/components/responses/TooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMedia"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
