{
  "name": "commerce-app",
  "version": "0.0.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": "12.2.0"
  },
  "packageManager": "npm@12.2.0",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "node scripts/workspace.mjs typecheck",
    "test": "node scripts/workspace.mjs test",
    "build": "node scripts/workspace.mjs build",
    "dev:api": "node scripts/workspace.mjs dev:api",
    "dev:web": "npm run dev --workspace @commerce/web",
    "start:api": "npm run start --workspace @commerce/api",
    "start:web": "npm run start --workspace @commerce/web"
  },
  "devEngines": {
    "runtime": {"name": "node", "version": ">=24.20.0 <25", "onFail": "error"},
    "packageManager": {"name": "npm", "version": "12.2.0", "onFail": "error"}
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "24.10.1",
    "eslint": "10.13.0",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
